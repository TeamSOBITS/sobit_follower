<launch>
    <arg name="rviz"                    default="false"/>
    <arg name="display_marker"          default="true"/>
    <arg name="rviz_cfg"                default="$(find sobits_follower)/config/rviz/sobits_follower.rviz"/>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_cfg)"/>

    <arg name="rqt_reconfigure"         default="false"/>
    <arg name="use_rotate"              default="true"/>

    <arg name="manager_name"            default="sobits_follower_nodelet_manager" />
    <arg name="manager_threads"         default="4" />

    <arg name="following_method"        default="0" />
    <!--
        0 : VirtualSpringModel-DynamicWindowApproach
        1 : VirtualSpringModel
        2 : DynamicWindowApproach
        3 : PIDController
    -->
    <arg name="use_smoother"       default="true" />

    <arg name="speech_mode"        default="true" />

    <include file="$(find sobits_follower)\launch\include\dr_spaam_ros.launch.xml"/>
    <!-- <include file="$(find sobits_follower)\launch\include\ssd_pose_ros.launch.xml"/> -->
    <include file="$(find yolov10_ros)\launch\yolov10_with_tf.launch">
        <arg name="detect_classes" value="['person']"/>  <!-- specify 'person' as the class to detect -->
        <arg name="fast_shot" value="true"/>              <!-- set fast_shot to true -->
    </include>

    <!-- person_id_nodelet -->
    <!-- <include file="$(find sobits_follower)\launch\include\person_id.launch.xml"/> -->
    <include file="$(find mono_following)\launch\mono_following.launch"/>

    <!-- 呼び止めるプログラム -->
    <group if="$(arg speech_mode)">
        <!-- text_to_speech -->
        <include file="$(find text_to_speech)\launch\japanese.launch"/>
        <!-- speech_node -->
        <!-- no_exists -->
        <!-- <node pkg="sobits_follower" type="speech_no_exists.py" name="speech1" output="screen"> -->
        <!-- </node> -->
        <!-- reid_state -->
        <!-- <node pkg="sobits_follower" type="speech_reid_state.py" name="speech2" output="screen">
        </node> -->
        <node pkg="sobits_follower" type="speech_reid_state_GRRSLT.py" name="speech2" output="screen">
        </node>
    </group>

    <group ns = "sobits_follower">
        <!-- <node pkg="nodelet" type="nodelet" name="$(arg manager_name)" args="manager" output="screen"> -->
        <node pkg="nodelet" type="nodelet" name="$(arg manager_name)" args="manager">
            <param name="num_worker_threads" value="$(arg manager_threads)" />
        </node>

        <include file="$(find sobits_follower)/launch/include/sobit_edu/sobit_edu_tracker_GRRSLT.launch.xml">
            <arg name="manager_name"        value="$(arg manager_name)" />
            <arg name="use_rotate"          value="$(arg use_rotate)"/>
            <arg name="display_marker"      value="$(arg display_marker)"/>
        </include>

        <include file="$(find sobits_follower)/launch/include/sobit_edu/sobit_edu_person_following_control.launch.xml" >
            <arg name="manager_name"        value="$(arg manager_name)" />
            <arg name="display_marker"      value="$(arg display_marker)"/>
            <arg name="following_method"    value="$(arg following_method)"/>
            <arg name="use_smoother"        value="$(arg use_smoother)"/>
        </include>
    </group>
    <node if="$(arg rqt_reconfigure)" pkg="rqt_reconfigure" type="rqt_reconfigure" name="rqt_reconfigure"/>
</launch>