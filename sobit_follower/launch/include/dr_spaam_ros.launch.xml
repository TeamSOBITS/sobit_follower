<launch>
    <arg name="weight_file"                 default="$(find dr_spaam_ros)/weights/ckpt_jrdb_ann_ft_dr_spaam_e20.pth"/>
    <group ns = "dr_spaam">
        <node pkg="dr_spaam_ros" type="node.py" name="dr_spaam_ros" output="screen">
            <param name="weight_file"               value="$(arg weight_file)" />
            <rosparam file="$(find sobit_follower)/param/dr_spaam_param.yaml" command="load" />
        </node>
    </group>
</launch>